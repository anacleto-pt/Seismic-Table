#include <AccelStepper.h>\
#include <WiFi.h>\
#include <WebServer.h>\
\
AccelStepper motorN(1, 4, 25);\
AccelStepper motorE(1, 26, 27);\
AccelStepper motorS(1, 14, 12);\
AccelStepper motorW(1, 32, 33);\
\
const int pinoEnable = 13;\
\
// WiFi Access Point \'97 liga o telem\'f3vel a esta rede\
const char* ssid     = "MesaSismica";\
const char* password = "12345678";\
\
WebServer server(80);\
\
// Par\'e2metros\
float FREQUENCIA_HZ = 2.0;\
int   MAX_STEPS     = 50;\
int   INTERVALO_MS  = 20;\
bool  ativo         = false;\
\
unsigned long ultimoUpdate = 0;\
float tempoDecorrido = 0;\
float faseNS = 0, faseEW = 0;\
float freqNS = 2.0, freqEW = 2.0 * 1.13;\
\
// \uc0\u9472 \u9472  HTML da interface \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
String paginaHTML() \{\
  String html = R"rawhtml(\
<!DOCTYPE html><html><head>\
<meta charset="UTF-8">\
<meta name="viewport" content="width=device-width, initial-scale=1">\
<title>Mesa S\'edsmica</title>\
<style>\
  body \{ font-family: Arial, sans-serif; background: #1a1a2e; color: #eee;\
         display: flex; flex-direction: column; align-items: center;\
         padding: 20px; margin: 0; \}\
  h1   \{ color: #e94560; margin-bottom: 5px; \}\
  .card \{ background: #16213e; border-radius: 12px; padding: 20px;\
          width: 100%; max-width: 400px; margin: 10px 0; \}\
  label \{ display: block; margin: 12px 0 4px; color: #a8b2d8; font-size: 14px; \}\
  input[type=range] \{ width: 100%; accent-color: #e94560; \}\
  .val  \{ text-align: right; color: #e94560; font-weight: bold; font-size: 18px; \}\
  .row  \{ display: flex; justify-content: space-between; align-items: center; \}\
  .btn  \{ width: 48%; padding: 14px; border: none; border-radius: 8px;\
          font-size: 16px; font-weight: bold; cursor: pointer; margin-top: 10px; \}\
  .start \{ background: #e94560; color: white; \}\
  .stop  \{ background: #444; color: #aaa; \}\
  .status \{ text-align: center; padding: 8px; border-radius: 6px;\
             font-weight: bold; margin-bottom: 10px; \}\
  .on  \{ background: #1a472a; color: #4caf50; \}\
  .off \{ background: #2d1b1b; color: #e94560; \}\
</style></head><body>\
<h1>\uc0\u55356 \u57101  Mesa S\'edsmica</h1>\
<div class="card">\
  <div id="status" class="status off">\uc0\u9679  PARADO</div>\
\
  <label>Frequ\'eancia: <span class="val" id="vF">)rawhtml";\
  html += String(FREQUENCIA_HZ, 1);\
  html += R"rawhtml( Hz</span></label>\
  <input type="range" id="freq" min="0.5" max="10" step="0.5" value=")rawhtml";\
  html += String(FREQUENCIA_HZ, 1);\
  html += R"rawhtml(" oninput="document.getElementById('vF').innerText=this.value+' Hz'">\
\
  <label>Amplitude (steps): <span class="val" id="vS">)rawhtml";\
  html += String(MAX_STEPS);\
  html += R"rawhtml(</span></label>\
  <input type="range" id="steps" min="5" max="150" step="5" value=")rawhtml";\
  html += String(MAX_STEPS);\
  html += R"rawhtml(" oninput="document.getElementById('vS').innerText=this.value">\
\
  <label>Intervalo: <span class="val" id="vI">)rawhtml";\
  html += String(INTERVALO_MS);\
  html += R"rawhtml( ms</span></label>\
  <input type="range" id="intv" min="10" max="100" step="5" value=")rawhtml";\
  html += String(INTERVALO_MS);\
  html += R"rawhtml(" oninput="document.getElementById('vI').innerText=this.value+' ms'">\
\
  <div class="row">\
    <button class="btn start" onclick="iniciar()">\uc0\u9654  INICIAR</button>\
    <button class="btn stop"  onclick="parar()">\uc0\u9632  PARAR</button>\
  </div>\
</div>\
\
<script>\
function iniciar() \{\
  const f = document.getElementById('freq').value;\
  const s = document.getElementById('steps').value;\
  const i = document.getElementById('intv').value;\
  fetch('/iniciar?f='+f+'&s='+s+'&i='+i)\
    .then(()=>\{ setStatus(true); \});\
\}\
function parar() \{\
  fetch('/parar').then(()=>\{ setStatus(false); \});\
\}\
function setStatus(on) \{\
  const el = document.getElementById('status');\
  el.className = 'status ' + (on ? 'on' : 'off');\
  el.innerText  = on ? '\uc0\u9679  A SIMULAR' : '\u9679  PARADO';\
\}\
// Atualiza estado ao carregar\
fetch('/estado').then(r=>r.text()).then(t=>setStatus(t==='1'));\
</script>\
</body></html>\
)rawhtml";\
  return html;\
\}\
\
// \uc0\u9472 \u9472  Handlers HTTP \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
void handleRoot() \{\
  server.send(200, "text/html", paginaHTML());\
\}\
\
void handleIniciar() \{\
  if (server.hasArg("f")) FREQUENCIA_HZ = server.arg("f").toFloat();\
  if (server.hasArg("s")) MAX_STEPS     = server.arg("s").toInt();\
  if (server.hasArg("i")) INTERVALO_MS  = server.arg("i").toInt();\
\
  freqNS = FREQUENCIA_HZ;\
  freqEW = FREQUENCIA_HZ * 1.13;\
  faseNS = random(0, 628) / 100.0;\
  faseEW = random(0, 628) / 100.0;\
\
  tempoDecorrido = 0;\
  ultimoUpdate   = millis();\
\
  digitalWrite(pinoEnable, LOW);\
  delay(50);\
  ativo = true;\
\
  server.send(200, "text/plain", "ok");\
\}\
\
void handleParar() \{\
  ativo = false;\
  motorN.setSpeed(0); motorE.setSpeed(0);\
  motorS.setSpeed(0); motorW.setSpeed(0);\
  digitalWrite(pinoEnable, HIGH);\
  server.send(200, "text/plain", "ok");\
\}\
\
void handleEstado() \{\
  server.send(200, "text/plain", ativo ? "1" : "0");\
\}\
\
// \uc0\u9472 \u9472  Setup \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
void setup() \{\
  Serial.begin(115200);\
  pinMode(pinoEnable, OUTPUT);\
  digitalWrite(pinoEnable, HIGH);\
\
  motorN.setMaxSpeed(60000); motorE.setMaxSpeed(60000);\
  motorS.setMaxSpeed(60000); motorW.setMaxSpeed(60000);\
\
  randomSeed(analogRead(0));\
\
  // Cria Access Point\
  WiFi.softAP(ssid, password);\
  IPAddress ip = WiFi.softAPIP();\
  Serial.print("Liga ao WiFi 'MesaSismica' e abre: http://");\
  Serial.println(ip);\
\
  server.on("/",        handleRoot);\
  server.on("/iniciar", handleIniciar);\
  server.on("/parar",   handleParar);\
  server.on("/estado",  handleEstado);\
  server.begin();\
\}\
\
// \uc0\u9472 \u9472  Loop \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
void loop() \{\
  server.handleClient();\
\
  if (!ativo) return;\
\
  unsigned long agora = millis();\
  if (agora - ultimoUpdate >= (unsigned long)INTERVALO_MS) \{\
    ultimoUpdate = agora;\
    tempoDecorrido += INTERVALO_MS / 1000.0;\
\
    float velNS = MAX_STEPS * sin(2.0 * PI * freqNS * tempoDecorrido + faseNS) / (INTERVALO_MS / 1000.0);\
    float velEW = MAX_STEPS * sin(2.0 * PI * freqEW * tempoDecorrido + faseEW) / (INTERVALO_MS / 1000.0);\
\
    motorN.setSpeed(velNS);  motorS.setSpeed(-velNS);\
    motorE.setSpeed(velEW);  motorW.setSpeed(-velEW);\
  \}\
\
  motorN.runSpeed(); motorS.runSpeed();\
  motorE.runSpeed(); motorW.runSpeed();\
\}}